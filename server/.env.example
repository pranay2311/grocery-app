# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/grocery?retryWrites=true&w=majority

# Which AI reads receipts: "gemini" (free tier, default) or "claude" (paid)
AI_PROVIDER=gemini

# Google Gemini API key (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
# Optional: Gemini models to try in order (if one is busy or retired, the next is used).
# Run `npm run models` to see what your key can use.
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash

# Only needed when AI_PROVIDER=claude (console.anthropic.com)
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Allowed frontend address(es), comma separated. Leave empty in development.
# CLIENT_ORIGIN=https://your-app.vercel.app

PORT=5000

# Secret for signing login tokens. Use a long random value, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
